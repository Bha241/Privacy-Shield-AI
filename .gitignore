# Root Gitignore
node_modules/
**/node_modules/
frontend/node_modules/
.venv/
**/.venv/
backend/.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc

# Large AI Model Files (>100MB)
*.gguf
*.bin
*.pt
*.onnx
*.safetensors
backend/app/agents/model_local/

# Generated outputs & uploads
backend/app/agents/web/output/
**/web/output/
output/
**/output/
backend/app/agents/web/uploads/*
!backend/app/agents/web/uploads/.gitkeep

# Frontend build
.next/
**/.next/
frontend/.next/
out/
build/
*.tsbuildinfo

# Secrets & Environment variables
.env
.env.*
!.env.example
*.env
frontend/.env*
backend/.env*

# Databases & local logs
*.db
*.sqlite
*.sqlite3
chroma_db/
.chroma/
out_pii.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
